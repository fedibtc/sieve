{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "published",
            "authored_only",
            "failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "trigger": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ci",
            "local",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
