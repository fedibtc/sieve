{
  "name": "sieve",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev -p 7919",
    "build": "next build",
    "start": "next start -p 7919",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schemas:export": "tsx scripts/export-schemas.ts",
    "schemas:check": "pnpm schemas:export && git diff --exit-code -- schemas",
    "check": "pnpm lint && pnpm typecheck && pnpm schemas:check && pnpm test",
    "validate:cli-plan": "node scripts/validate-cli-plan.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "skill:install": "node scripts/install-skill.mjs",
    "test:e2e:guard": "node scripts/check-e2e-interactions.mjs",
    "test:e2e": "rm -rf .next && pnpm build && pnpm test:e2e:guard && playwright test",
    "test:e2e:fast": "pnpm test:e2e:guard && playwright test",
    "test:e2e:ui": "rm -rf .next && pnpm build && pnpm test:e2e:guard && playwright test --ui"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.23",
    "@electric-sql/pglite": "^0.5.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-slot": "^1.3.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "nanoid": "^5.1.16",
    "next": "15.5.21",
    "pg": "^8.22.0",
    "react": "19",
    "react-dom": "19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
